---
const currentYear = new Date().getFullYear();
import Logo from './Logo.astro';
import { obtenerConfiguracionWhatsApp } from '../../services/configuracionService';

const config = await obtenerConfiguracionWhatsApp();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Columna 1: Marca y descripción -->
      <div class="lg:col-span-2 space-y-4">
        <!-- Logo SIAPP siempre en versión oscura para el fondo oscuro del footer -->
        <Logo forceTheme="dark" />
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Plataforma tecnológica líder para la gestión integral de instituciones
          educativas, institutos superiores, centros técnicos y universidades en
          el Perú.
        </p>
        <div class="pt-2 flex items-center gap-3 text-slate-400">
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-blue-600 hover:text-white flex items-center justify-center transition-colors"
          >
            <i class="fa-brands fa-facebook-f text-sm"></i>
          </a>
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-blue-400 hover:text-white flex items-center justify-center transition-colors"
          >
            <i class="fa-brands fa-linkedin-in text-sm"></i>
          </a>
          <a
            href={config.urlWhatsAppGeneral}
            data-whatsapp-link="general"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp SIAPP"
            class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-[#25D366] hover:text-white flex items-center justify-center transition-colors"
          >
            <i class="fa-brands fa-whatsapp text-sm"></i>
          </a>
        </div>
      </div>

      <!-- Columna 2: Módulos -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white font-['Outfit',sans-serif]">
          Módulos
        </h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li>
            <a
              href="/modulos#academico"
              class="hover:text-cyan-400 transition-colors"
            >
              Gestión Académica
            </a>
          </li>
          <li>
            <a
              href="/modulos#tesoreria"
              class="hover:text-cyan-400 transition-colors"
            >
              Caja y Tesorería
            </a>
          </li>
          <li>
            <a
              href="/modulos#matriculas"
              class="hover:text-cyan-400 transition-colors"
            >
              Matrículas en Línea
            </a>
          </li>
          <li>
            <a
              href="/modulos#asistencia"
              class="hover:text-cyan-400 transition-colors"
            >
              Asistencias y Biométrico
            </a>
          </li>
          <li>
            <a
              href="/modulos#sunat"
              class="hover:text-cyan-400 transition-colors"
            >
              Facturación SUNAT
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Enlaces Rápidos -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white font-['Outfit',sans-serif]">
          Plataforma
        </h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li>
            <a href="/planes" class="hover:text-cyan-400 transition-colors">
              Planes y Precios
            </a>
          </li>
          <li>
            <a href="/nosotros" class="hover:text-cyan-400 transition-colors">
              Sobre Nosotros
            </a>
          </li>
          <li>
            <a href="/contacto" class="hover:text-cyan-400 transition-colors">
              Solicitar Demostración
            </a>
          </li>
          <li>
            <a
              href="/clientes"
              class="text-amber-400 hover:text-amber-300 font-medium transition-colors flex items-center gap-1.5"
            >
              <i class="fa-light fa-wallet text-xs"></i> Portal de Clientes
            </a>
          </li>
          <li>
            <a
              href="https://itep.siapp.edu.pe"
              target="_blank"
              class="hover:text-cyan-400 transition-colors"
            >
              Ingreso a Sistema
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Contacto directo -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white font-['Outfit',sans-serif]">
          Contacto
        </h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li class="flex items-start gap-2.5">
            <i class="fa-light fa-location-dot mt-1 text-blue-400"></i>
            <span>Arequipa / Lima, Perú</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-light fa-phone text-blue-400"></i>
            <a
              href={`tel:+${config.numero}`}
              data-tel-link
              class="hover:text-blue-400 transition-colors"
            >
              <span data-whatsapp-text="numeroFormateado">{config.numeroFormateado}</span>
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-light fa-envelope text-blue-400"></i>
            <span>ventas@siapp.pe</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-light fa-headset text-blue-400"></i>
            <span>soporte@siapp.pe</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior copyright -->
    <div class="pt-10 mt-10 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {currentYear} SIAPP - Sistema Integral Académico. Todos los derechos
        reservados.
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-slate-400 transition-colors">
          Términos del Servicio
        </a>
        <a href="#" class="hover:text-slate-400 transition-colors">
          Política de Privacidad
        </a>
        <a href="/clientes" class="hover:text-amber-400 transition-colors">
          Pagos en Línea
        </a>
      </div>
    </div>
  </div>
</footer>
