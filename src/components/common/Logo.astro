---
interface Props {
  href?: string;
  class?: string;
  forceTheme?: 'light' | 'dark' | 'auto';
}

const { href = '/', class: className = '', forceTheme = 'auto' } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-3 group transition-all duration-200 ${className}`}
>
  <!-- ISOTIPO -->
  {forceTheme === 'light' ? (
    <img
      src="/images/sistema/isotipoazul.png"
      alt="Isotipo SIAPP"
      class="w-10 h-10 sm:w-11 sm:h-11 object-contain translate-x-0.5 shrink-0"
    />
  ) : forceTheme === 'dark' ? (
    <img
      src="/images/sistema/isotipoblanco.png"
      alt="Isotipo SIAPP"
      class="w-10 h-10 sm:w-11 sm:h-11 object-contain translate-x-0.5 shrink-0"
    />
  ) : (
    <>
      <img
        src="/images/sistema/isotipoazul.png"
        alt="Isotipo SIAPP"
        class="w-10 h-10 sm:w-11 sm:h-11 object-contain translate-x-0.5 shrink-0 dark:hidden"
      />
      <img
        src="/images/sistema/isotipoblanco.png"
        alt="Isotipo SIAPP"
        class="w-10 h-10 sm:w-11 sm:h-11 object-contain translate-x-0.5 shrink-0 hidden dark:block"
      />
    </>
  )}

  <!-- LETRAS LOGO -->
  {forceTheme === 'light' ? (
    <img
      src="/images/sistema/letraslogo.png"
      alt="SIAPP - Digitalización Educativa"
      class="h-10 sm:h-11 w-auto object-contain shrink-0"
    />
  ) : forceTheme === 'dark' ? (
    <img
      src="/images/sistema/letraslogodark.png"
      alt="SIAPP - Digitalización Educativa"
      class="h-10 sm:h-11 w-auto object-contain shrink-0"
    />
  ) : (
    <>
      <img
        src="/images/sistema/letraslogo.png"
        alt="SIAPP - Digitalización Educativa"
        class="h-10 sm:h-11 w-auto object-contain shrink-0 dark:hidden"
      />
      <img
        src="/images/sistema/letraslogodark.png"
        alt="SIAPP - Digitalización Educativa"
        class="h-10 sm:h-11 w-auto object-contain shrink-0 hidden dark:block"
      />
    </>
  )}
</a>
