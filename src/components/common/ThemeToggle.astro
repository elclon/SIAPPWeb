---
// Componente de cambio de tema: Modo Claro / Modo Oscuro
---

<button
  type="button"
  class="theme-toggle-btn relative p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100/80 dark:bg-slate-900/80 text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-all duration-200 focus:outline-none shadow-xs"
  aria-label="Alternar tema claro y oscuro"
  title="Cambiar a modo claro/oscuro"
>
  <!-- Icono Sol (se muestra en modo oscuro para cambiar a claro) -->
  <i class="fa-light fa-sun-bright text-lg hidden dark:block text-amber-400 transition-transform duration-200 hover:rotate-45"></i>
  <!-- Icono Luna (se muestra en modo claro para cambiar a oscuro) -->
  <i class="fa-light fa-moon-stars text-lg block dark:hidden text-slate-700 transition-transform duration-200 hover:-rotate-12"></i>
</button>

<script>
  function setupThemeToggle() {
    const buttons = document.querySelectorAll('.theme-toggle-btn');
    
    buttons.forEach((btn) => {
      // Remover event listener previo si existiera para evitar duplicados
      btn.replaceWith(btn.cloneNode(true));
    });

    const refreshedButtons = document.querySelectorAll('.theme-toggle-btn');
    refreshedButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    });
  }

  // Inicializar en carga y en navegaciones
  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
