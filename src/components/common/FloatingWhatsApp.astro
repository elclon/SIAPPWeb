---
import { obtenerConfiguracionWhatsApp } from '../../services/configuracionService';

interface Props {
  phone?: string;
  message?: string;
}

const config = await obtenerConfiguracionWhatsApp();

const {
  phone = config.numero,
  message = config.mensajeVentas || config.mensajeGeneral
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<!-- Botón Flotante de WhatsApp -->
<aside class="fixed bottom-6 right-6 z-50 flex items-center gap-3 group" aria-label="Contacto por WhatsApp">
  <!-- Tooltip / Mensaje flotante -->
  <a
    href={whatsappUrl}
    data-whatsapp-link="ventas"
    target="_blank"
    rel="noopener noreferrer"
    class="hidden md:flex items-center gap-2 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 px-3.5 py-2 rounded-full shadow-lg border border-slate-200/80 dark:border-slate-800 text-xs font-semibold hover:text-[#25D366] dark:hover:text-[#25D366] transition-all duration-300 opacity-90 group-hover:opacity-100 group-hover:scale-105"
  >
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span>¿En qué podemos ayudarte? <strong>Escríbenos</strong></span>
  </a>

  <!-- Botón circular principal -->
  <a
    href={whatsappUrl}
    data-whatsapp-link="ventas"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Abrir chat de WhatsApp con soporte y ventas SIAPP"
    class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white flex items-center justify-center shadow-xl shadow-emerald-900/30 hover:shadow-2xl hover:shadow-emerald-900/50 hover:scale-110 active:scale-95 transition-all duration-300 group focus:outline-hidden focus:ring-4 focus:ring-emerald-400/50"
  >
    <!-- Efecto Onda Pulsante -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-25 pointer-events-none"></span>

    <!-- Icono de WhatsApp -->
    <i class="fa-brands fa-whatsapp text-2xl sm:text-3xl relative z-10 transition-transform duration-300 group-hover:scale-110"></i>
  </a>
</aside>
