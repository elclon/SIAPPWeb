---
---

<section class="relative pt-10 pb-20 lg:pt-16 lg:pb-28 bg-white dark:bg-slate-950 transition-colors duration-200">
  <!-- GRADIENTES DE FONDO AURORA (Celeste a la izquierda, Cálido Durazno/Rosa a la derecha) -->
  <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-gradient-to-tr from-sky-200/50 dark:from-sky-900/20 via-blue-100/40 dark:via-blue-900/15 to-transparent rounded-full blur-3xl pointer-events-none -translate-x-1/3 -translate-y-1/4"></div>
  <div class="absolute top-10 right-0 w-[650px] h-[650px] bg-gradient-to-bl from-rose-200/45 dark:from-rose-900/15 via-orange-100/35 dark:via-orange-900/10 to-transparent rounded-full blur-3xl pointer-events-none translate-x-1/4"></div>

  <!-- LÍNEAS VECTORIALES ONDULADAS ORGÁNICAS (SVG CONTOUR WAVE LINES) -->
  <div class="absolute inset-0 pointer-events-none opacity-30 dark:opacity-20 overflow-hidden">
    <svg
      class="w-full h-full"
      viewBox="0 0 1440 900"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <path
        d="M-100 200 C 300 120, 450 380, 800 220 C 1150 60, 1300 350, 1600 240"
        stroke="#3b82f6"
        stroke-width="1.2"
        stroke-dasharray="6 6"
        fill="none"
      />
      <path
        d="M-50 350 C 350 220, 500 480, 900 320 C 1200 200, 1350 480, 1650 360"
        stroke="#6366f1"
        stroke-width="1"
        fill="none"
      />
      <path
        d="M0 500 C 400 380, 600 620, 1000 450 C 1300 320, 1400 580, 1700 480"
        stroke="#f43f5e"
        stroke-width="1"
        opacity="0.6"
        fill="none"
      />
    </svg>
  </div>

  <!-- ELEMENTOS FLOTANTES 3D (ESFERAS, ANILLOS Y DIAMANTES DECORATIVOS) -->
  <div class="absolute inset-0 max-w-7xl mx-auto pointer-events-none overflow-hidden">
    <!-- Esfera Púrpura 3D Flotante (Izquierda) -->
    <div class="absolute top-44 left-6 sm:left-14 w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-purple-700 via-indigo-600 to-purple-400 shadow-xl shadow-purple-600/35 animate-float"></div>

    <!-- Diamante / Cuadrado Hueco Azul (Izquierda Superior) -->
    <div class="absolute top-28 left-20 sm:left-36 w-6 h-6 border-2 border-blue-500 rounded-sm rotate-45 opacity-70 animate-float-reverse"></div>

    <!-- Anillo Magenta 3D (Derecha Superior) -->
    <div class="absolute top-24 right-16 sm:right-36 w-8 h-8 rounded-full border-[3px] border-rose-500 opacity-70 animate-float"></div>

    <!-- Puntos Geométricos Sutiles -->
    <div class="absolute top-20 left-1/3 w-2.5 h-2.5 rounded-full bg-blue-600 opacity-80"></div>
    <div class="absolute top-48 right-1/4 w-3 h-3 rounded-full bg-emerald-500 opacity-80 animate-pulse"></div>
    <div class="absolute top-64 right-12 w-2 h-2 rounded-full bg-orange-500 opacity-80"></div>
  </div>

  <!-- CONTENIDO DEL HERO -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- CABECERA DE TEXTO DEL HERO -->
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <!-- Título Principal Exacto de SIAPP -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.12] font-heading">
        Sistema Integral Académico <br class="hidden sm:inline" />
        <span class="text-blue-600 dark:text-blue-400 font-black">&</span>{' '}
        Plataforma Pedagógica
      </h1>

      <!-- Subtítulo Fiel a la Propuesta de Valor -->
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal max-w-2xl mx-auto">
        Novedoso software de gestión académica de nivel superior. Permite
        gestionar todo el proceso educativo desde la matrícula hasta la
        graduación y seguimiento de egresado de un alumno.
      </p>

      <!-- Botón CTA Rojo/Naranja en Píldora (Estilo Identitario) -->
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contacto"
          class="px-9 py-4 rounded-full text-base font-bold bg-gradient-to-r from-red-500 via-rose-500 to-orange-500 hover:from-red-600 hover:to-orange-600 active:scale-[0.98] text-white shadow-xl shadow-orange-500/25 hover:shadow-orange-500/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2.5"
        >
          <span>Solicita una cita demostrativa</span>
          <i class="fa-light fa-calendar-check text-lg"></i>
        </a>

        <a
          href="/modulos"
          class="px-7 py-4 rounded-full text-base font-semibold border border-slate-300 dark:border-slate-700 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-800 hover:border-slate-400 dark:hover:border-slate-600 hover:text-slate-900 dark:hover:text-white transition-all flex items-center justify-center gap-2"
        >
          <i class="fa-light fa-layer-group text-blue-600 dark:text-blue-400"></i>
          <span>Explorar Módulos</span>
        </a>
      </div>
    </div>

    <!-- SHOWCASE DE DISPOSITIVOS: LAPTOP CON CAPTURA DEL SISTEMA + MÓVIL FLOTANTE -->
    <div class="mt-14 sm:mt-18 relative max-w-5xl mx-auto">
      <!-- Blob Orgánico Azul de Fondo (Detrás del Laptop) -->
      <div class="absolute -top-12 -right-8 sm:-right-12 w-64 sm:w-80 h-64 sm:h-80 bg-blue-600 rounded-[40%_60%_70%_30%/40%_50%_60%_50%] opacity-90 blur-xs pointer-events-none -z-10 animate-float-slow"></div>
      <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-gradient-to-tr from-purple-600 to-indigo-600 rounded-full opacity-20 blur-3xl pointer-events-none -z-10"></div>

      <!-- MOCKUP DE LAPTOP PROFESIONAL -->
      <div class="relative z-10 mx-auto rounded-t-3xl bg-slate-950 p-3 sm:p-4 shadow-2xl shadow-slate-900/30 border border-slate-800">
        <!-- Cámara Web y Notch Superior -->
        <div class="flex items-center justify-center pb-2.5 relative">
          <span class="w-2.5 h-2.5 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-blue-900"></span>
          </span>
        </div>

        <!-- Pantalla del Laptop -->
        <div class="relative rounded-xl overflow-hidden bg-slate-900 border border-slate-800 aspect-[1920/911] flex items-center justify-center group">
          <!-- Imagen real si el usuario coloca: public/images/sistema/pantalla-principal.png -->
          <img
            src="/images/sistema/pantalla-principal.png"
            alt="SIAPP - Pantalla Principal del Sistema"
            class="w-full h-full relative z-10"
            onerror="this.style.display='none'"
          />

          <!-- Fallback Interactivo de Alta Fidelidad de la Interfaz SIAPP (Ribbon + Módulos) -->
          <div class="absolute inset-0 bg-slate-100 flex flex-col justify-between text-slate-800 select-none z-0">
            <!-- Barra de Título Superior de Windows -->
            <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white px-4 py-2 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <i class="fa-sharp fa-solid fa-graduation-cap text-blue-400"></i>
                <span class="font-bold tracking-tight">
                  Sistema Integral Académico &bull; SIAPP ERP v10.0
                </span>
              </div>
              <div class="flex items-center gap-3 text-[11px] text-slate-300 font-mono">
                <span>Sucursal: Central Lima</span>
                <span>Usuario: Administrador</span>
              </div>
            </div>

            <!-- Ribbon Navigation Bar de SIAPP -->
            <div class="bg-white border-b border-slate-200 px-4 py-2.5 shadow-xs">
              <!-- Pestañas del Ribbon -->
              <div class="flex items-center gap-1 sm:gap-2 pb-2 text-xs font-semibold border-b border-slate-100">
                <span class="px-3 py-1 rounded bg-blue-600 text-white font-bold">
                  Académico
                </span>
                <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">
                  Caja y Tesorería
                </span>
                <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">
                  Facturación SUNAT
                </span>
                <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">
                  Docentes
                </span>
                <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">
                  Reportes
                </span>
                <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">
                  Seguridad
                </span>
              </div>

              <!-- Botones de Acción del Ribbon -->
              <div class="flex items-center gap-4 pt-2 overflow-x-auto text-[11px] text-slate-700">
                <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                  <i class="fa-light fa-id-card text-xl text-blue-600"></i>
                  <span>Ficha Alumno</span>
                </div>
                <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                  <i class="fa-light fa-user-plus text-xl text-indigo-600"></i>
                  <span>Matrícula</span>
                </div>
                <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                  <i class="fa-light fa-file-invoice text-xl text-emerald-600"></i>
                  <span>Cobranzas</span>
                </div>
                <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                  <i class="fa-light fa-fingerprint text-xl text-purple-600"></i>
                  <span>Asistencias</span>
                </div>
                <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                  <i class="fa-light fa-chart-line-up text-xl text-amber-600"></i>
                  <span>Estadísticas</span>
                </div>
              </div>
            </div>

            <!-- Área de Trabajo Central con Marca de Agua del Escudo -->
            <div class="my-auto p-6 flex flex-col items-center justify-center relative">
              <!-- Marca de Agua del Escudo y Birrete (Tal como en siapp.edu.pe) -->
              <div class="opacity-15 flex flex-col items-center text-slate-400">
                <i class="fa-sharp fa-solid fa-graduation-cap text-8xl sm:text-9xl"></i>
                <span class="font-['Outfit',sans-serif] font-black text-2xl tracking-widest mt-2 uppercase text-slate-400">
                  SIAPP
                </span>
              </div>
              <div class="absolute bottom-4 left-4 text-xs text-slate-400 font-medium">
                Instituto de Educación Superior Tecnológico &bull; Ciclo 2026-II
              </div>
            </div>
          </div>
        </div>

        <!-- Base del Laptop (Teclado / Bisagra) -->
        <div class="h-4 sm:h-5 bg-gradient-to-b from-slate-800 to-slate-900 rounded-b-xl -mb-2 shadow-md flex items-center justify-center">
          <span class="w-16 h-1 rounded-full bg-slate-700"></span>
        </div>
      </div>

      <!-- TARJETA FLOTANTE 1: COMUNIDAD Y ESTUDIANTES (+50,000 Alumnos) -->
      <div class="absolute top-14 sm:top-24 md:top-28 -left-3 sm:-left-8 lg:-left-12 w-32 sm:w-44 bg-white dark:bg-slate-900 rounded-2xl overflow-hidden shadow-2xl border-4 border-white dark:border-slate-800 transform -rotate-3 hover:rotate-0 hover:scale-105 transition-all duration-300 z-30 hidden sm:block">
        <img
          src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=400&q=80"
          alt="Estudiantes Universitarios"
          class="w-full h-20 sm:h-28 object-cover"
        />
        <div class="bg-white dark:bg-slate-900 p-2.5 text-center">
          <div class="flex items-center justify-center gap-1.5 mb-0.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[11px] sm:text-xs font-black text-slate-800 dark:text-white tracking-tight">
              +50,000 Alumnos
            </span>
          </div>
          <span class="block text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400 font-medium">
            Gestión Activa en Nube
          </span>
        </div>
      </div>

      <!-- TARJETA FLOTANTE 2: HOMOLOGACIÓN SUNAT & COBRANZAS BANCARIAS -->
      <div class="absolute -bottom-6 sm:bottom-8 -left-3 sm:-left-6 lg:-left-10 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl p-3 sm:p-4 shadow-2xl border border-slate-100 dark:border-slate-800 flex items-center gap-3 transform rotate-2 hover:rotate-0 hover:scale-105 transition-all duration-300 z-30 max-w-[260px] sm:max-w-xs">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-500/30 flex items-center justify-center shrink-0">
          <i class="fa-sharp fa-solid fa-shield-check text-xl sm:text-2xl text-emerald-600 dark:text-emerald-400"></i>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white leading-tight">
              SUNAT & Cobranzas
            </span>
            <span class="px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 text-[9px] font-bold">
              100% OK
            </span>
          </div>
          <span class="block text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">
            Facturación y Recaudación Bancaria en Tiempo Real
          </span>
        </div>
      </div>

      <!-- MOCKUP DE CELULAR (SMARTPHONE) AL COSTADO DE LA PANTALLA PRINCIPAL (MÁS ABAJO Y ORIENTADO SEGÚN IMAGEN) -->
      <div
        class="absolute z-20 transition-transform duration-300 hover:scale-[1.02]"
        style="
        bottom: -180px; 
        right: -40px; 
        width: 260px; 
        transform: perspective(1200px) rotateX(25deg) rotateY(-10deg) rotateZ(35deg); 
        transform-style: preserve-3d;"
      >
        <!-- Chasis del Smartphone (Blanco / Plateado pulido con bisel suave y bordes redondeados) -->
        <div class="relative bg-white dark:bg-slate-100 p-2.5 sm:p-3 rounded-[2.6rem] sm:rounded-[3rem] shadow-[0_30px_70px_-15px_rgba(0,0,0,0.35),0_15px_30px_-10px_rgba(0,0,0,0.15)] border-4 sm:border-[6px] border-slate-100 ring-1 ring-slate-300/80">
          <!-- Botón de Encendido Lateral Derecho -->
          <div class="absolute -right-1 top-24 w-1 h-9 bg-slate-200 rounded-r-sm"></div>
          <!-- Botones de Volumen Lateral Izquierdo -->
          <div class="absolute -left-1 top-20 w-1 h-7 bg-slate-200 rounded-l-sm"></div>
          <div class="absolute -left-1 top-30 w-1 h-7 bg-slate-200 rounded-l-sm"></div>

          <!-- Pantalla del Celular -->
          <div class="relative rounded-[2rem] sm:rounded-[2.4rem] overflow-hidden bg-slate-900 aspect-[9/19] flex flex-col justify-between select-none border border-slate-200/80">
            <!-- Imagen real si el usuario coloca: public/images/sistema/pantalla-movil.png -->
            <img
              src="/images/sistema/pantalla-movil.png"
              alt="SIAPP Móvil - App del Estudiante"
              class="w-full h-full relative z-10"
              onerror="this.style.display='none'"
            />

            <!-- Fallback Interactivo de la App Móvil de Alumnos / Docentes (Si no hay PNG cargado) -->
            <div class="absolute inset-0 bg-slate-50 flex flex-col justify-between text-slate-800 z-0 p-2.5 sm:p-3">
              <!-- Dynamic Island / Cámara Frontal + Barra de Estado -->
              <div class="flex items-center justify-between pt-0.5 pb-1">
                <span class="text-[9px] sm:text-[10px] font-bold text-slate-900 font-mono">
                  09:41
                </span>
                <!-- Dynamic Island Capsule -->
                <div class="w-14 sm:w-18 h-3 sm:h-3.5 bg-black rounded-full flex items-center justify-end px-1.5 gap-1">
                  <span class="w-1 h-1 rounded-full bg-blue-950"></span>
                  <span class="w-1 h-1 rounded-full bg-slate-800"></span>
                </div>
                <!-- Iconos de Estado (WiFi, Batería) -->
                <div class="flex items-center gap-1 text-[8px] sm:text-[9px] text-slate-700">
                  <i class="fa-solid fa-wifi"></i>
                  <i class="fa-solid fa-battery-full text-emerald-600"></i>
                </div>
              </div>

              <!-- Cabecera de la App SIAPP Móvil -->
              <div class="flex items-center justify-between py-1 border-b border-slate-200">
                <div class="flex items-center gap-1.5">
                  <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-lg bg-blue-600 flex items-center justify-center text-white shadow-xs">
                    <i class="fa-sharp fa-solid fa-graduation-cap text-[10px]"></i>
                  </div>
                  <div>
                    <span class="block text-[10px] sm:text-[11px] font-black tracking-tight text-slate-900">
                      SIAPP Móvil
                    </span>
                    <span class="block text-[7px] sm:text-[8px] text-slate-400 font-semibold -mt-0.5">
                      Portal Estudiante
                    </span>
                  </div>
                </div>
                <div class="relative">
                  <i class="fa-light fa-bell text-slate-600 text-xs"></i>
                  <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-red-500"></span>
                </div>
              </div>

              <!-- Contenido Principal de la App Móvil -->
              <div class="space-y-1.5 sm:space-y-2 py-1 flex-1 flex flex-col justify-center">
                <!-- Card de Saludo y Alumno -->
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl p-2 sm:p-2.5 text-white shadow-sm">
                  <span class="text-[8px] sm:text-[9px] text-blue-100 block">
                    Bienvenido,
                  </span>
                  <span class="text-[10px] sm:text-xs font-bold block leading-tight">
                    Carlos Zegarra
                  </span>
                  <div class="flex items-center justify-between mt-1 pt-1 border-t border-white/20 text-[7px] sm:text-[8px]">
                    <span class="text-blue-100">Desarrollo Web</span>
                    <span class="bg-white/20 px-1.5 py-0.5 rounded font-mono font-semibold">
                      IV Ciclo
                    </span>
                  </div>
                </div>

                <!-- KPIs Rápidos: Promedio y Pagos -->
                <div class="grid grid-cols-2 gap-1.5">
                  <div class="bg-white rounded-lg p-1.5 border border-slate-200 shadow-xs text-center">
                    <span class="text-[7px] text-slate-500 block">
                      Promedio
                    </span>
                    <span class="text-xs sm:text-sm font-black text-emerald-600">
                      17.8
                    </span>
                    <span class="text-[6px] text-emerald-700 bg-emerald-50 px-1 rounded block">
                      Puesto 1
                    </span>
                  </div>
                  <div class="bg-white rounded-lg p-1.5 border border-slate-200 shadow-xs text-center">
                    <span class="text-[7px] text-slate-500 block">
                      Cuota Mensual
                    </span>
                    <span class="text-xs sm:text-sm font-black text-blue-600">
                      Al Día
                    </span>
                    <span class="text-[6px] text-blue-700 bg-blue-50 px-1 rounded block">
                      Pagado
                    </span>
                  </div>
                </div>

                <!-- Accesos Directos Táctiles -->
                <div class="grid grid-cols-3 gap-1 pt-0.5 text-center">
                  <div class="p-1 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-700">
                    <i class="fa-light fa-calendar-clock text-blue-600 text-xs block"></i>
                    <span class="text-[7px] font-semibold mt-0.5 block">
                      Horario
                    </span>
                  </div>
                  <div class="p-1 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-700">
                    <i class="fa-light fa-file-certificate text-emerald-600 text-xs block"></i>
                    <span class="text-[7px] font-semibold mt-0.5 block">
                      Notas
                    </span>
                  </div>
                  <div class="p-1 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-700">
                    <i class="fa-light fa-qrcode text-purple-600 text-xs block"></i>
                    <span class="text-[7px] font-semibold mt-0.5 block">
                      QR
                    </span>
                  </div>
                </div>
              </div>

              <!-- Barra de Navegación Inferior Móvil -->
              <div class="pt-1 border-t border-slate-200">
                <div class="flex items-center justify-around text-slate-400 text-[11px] pb-1">
                  <i class="fa-solid fa-house text-blue-600"></i>
                  <i class="fa-light fa-book-bookmark"></i>
                  <i class="fa-light fa-receipt"></i>
                  <i class="fa-light fa-user"></i>
                </div>
                <!-- Barra Indicadora de Inicio (Home Indicator Pill) -->
                <div class="w-14 h-1 bg-slate-300 rounded-full mx-auto mt-0.5"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
