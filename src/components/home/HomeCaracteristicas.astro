---
// Componente de Características Destacadas de SIAPP
---

<section class="py-16 sm:py-24 bg-white relative overflow-hidden">
  <!-- Elementos decorativos de fondo flotantes (Puntos sutiles como en el diseño) -->
  <div class="absolute top-12 right-1/3 w-2.5 h-2.5 rounded-full bg-blue-500 opacity-60 hidden lg:block"></div>
  <div class="absolute top-24 right-1/4 w-2 h-2 rounded-full bg-orange-500 opacity-70 hidden lg:block"></div>
  <div class="absolute bottom-16 right-12 w-3 h-3 rounded-full bg-indigo-400 opacity-50 hidden lg:block"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- COLUMNA IZQUIERDA: CONTENIDO Y CARACTERÍSTICAS -->
      <div class="lg:col-span-6 space-y-8">
        <!-- Encabezado de Sección -->
        <div class="space-y-2">
          <span class="text-blue-600 font-bold text-sm sm:text-base tracking-wide block">
            Aún hay mas...
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
            Otras características
          </h2>
          <p class="text-slate-500 text-sm sm:text-base pt-2 leading-relaxed max-w-lg">
            Potentes módulos complementarios que integran la vida académica, el
            acceso institucional y la empleabilidad de sus estudiantes en una
            sola plataforma.
          </p>
        </div>

        <!-- LISTA DE CARACTERÍSTICAS -->
        <div class="space-y-7 pt-2">
          <!-- 1. Control de Asistencias -->
          <div class="flex items-start gap-4 sm:gap-5 group">
            <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center shrink-0 shadow-xs group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
              <i class="fa-light fa-shield-check text-2xl text-blue-600 group-hover:text-white transition-colors duration-300"></i>
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                Emisión de Certificados
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed max-w-md">
                Emite certificados de estudios y constancias de notas con firma
                electrónica, códigos de validación y sellos de agua digitales,
                garantizando su autenticidad y seguridad para fines laborales o
                académicos.
              </p>
            </div>
          </div>

          <!-- 2. Bolsa de Trabajo -->
          <div class="flex items-start gap-4 sm:gap-5 group">
            <div class="w-12 h-12 rounded-xl bg-orange-50 border border-orange-100 flex items-center justify-center shrink-0 shadow-xs group-hover:bg-orange-500 group-hover:text-white transition-colors duration-300">
              <i class="fa-light fa-bullhorn text-2xl text-orange-600 group-hover:text-white transition-colors duration-300"></i>
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-orange-600 transition-colors">
                Bolsa de trabajo
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed max-w-md">
                Mantenga informados a sus alumnos y egresados acerca de las
                propuestas laborales, convenios de prácticas preprofesionales y
                convocatorias empresariales.
              </p>
            </div>
          </div>

          <!-- 3. Seguimiento de Egresados -->
          <div class="flex items-start gap-4 sm:gap-5 group">
            <div class="w-12 h-12 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0 shadow-xs group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300">
              <i class="fa-light fa-user-graduate text-2xl text-indigo-600 group-hover:text-white transition-colors duration-300"></i>
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
                Seguimiento de egresados
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed max-w-md">
                Monitoree la inserción laboral y trayectoria profesional de sus
                graduados mediante encuestas automatizadas e indicadores para
                licenciamiento institucional.
              </p>
            </div>
          </div>
        </div>

        <!-- Botón de Acción "Conoce más" -->
        <div class="pt-4">
          <a
            href="/modulos"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl text-base font-bold text-white bg-[#ff4d2d] hover:bg-[#e63f20] shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>Conoce más</span>
          </a>
        </div>
      </div>

      <!-- COLUMNA DERECHA: ILUSTRACIÓN DE CRECIMIENTO Y GESTIÓN -->
      <div class="lg:col-span-6 flex items-center justify-center">
        <div class="relative max-w-lg lg:max-w-none w-full">
          <!-- Fondo difuminado orgánico -->
          <div class="absolute inset-0 bg-gradient-to-tr from-blue-100/60 via-orange-50/40 to-indigo-100/50 rounded-3xl blur-2xl -z-10 transform scale-95"></div>

          <!-- Ilustración de Características -->
          <img
            src="/images/caracteristicas-siapp.jpg"
            alt="Otras características de SIAPP - Gestión Integral"
            class="w-full h-auto object-contain rounded-2xl drop-shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
