---
import { modulos } from './modulosData';
---

<section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
  {modulos.map((m, index) => {
    const isEven = index % 2 === 0;
    return (
      <div id={m.id} class="scroll-mt-28 bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-8 lg:p-12 shadow-sm hover:shadow-md transition-all">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Texto -->
          <div class={`lg:col-span-7 space-y-5 ${!isEven ? 'lg:order-2' : ''}`}>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              <i class={m.icon}></i>
              <span>{m.tag}</span>
            </div>
            
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white font-heading">
              {m.title}
            </h2>
            
            <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed">
              {m.description}
            </p>

            <div class="pt-2">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400 mb-3">
                Funcionalidades Principales:
              </h4>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {m.features.map(f => (
                  <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
                    <i class="fa-solid fa-circle-check text-emerald-500 mt-1 text-xs"></i>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4">
              <a
                href="/contacto"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-blue-600 dark:bg-slate-800 dark:hover:bg-blue-600 text-white text-sm font-semibold transition-colors"
              >
                <span>Solicitar demo de este módulo</span>
                <i class="fa-light fa-arrow-right text-xs"></i>
              </a>
            </div>
          </div>

          <!-- Columna Visual / Tarjeta de Representación -->
          <div class={`lg:col-span-5 ${!isEven ? 'lg:order-1' : ''}`}>
            <div class={`rounded-2xl p-8 bg-gradient-to-br ${m.color} text-white shadow-xl flex flex-col justify-between min-h-[300px] relative overflow-hidden`}>
              <div class="absolute -right-6 -bottom-6 opacity-15 text-9xl">
                <i class={m.icon}></i>
              </div>
              <div class="space-y-4 relative z-10">
                <div class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-3xl">
                  <i class={m.icon}></i>
                </div>
                <div class="text-2xl font-bold font-heading">{m.title}</div>
                <div class="text-white/80 text-sm leading-relaxed">{m.description}</div>
              </div>
              <div class="pt-6 relative z-10 flex items-center justify-between text-xs text-white/90 border-t border-white/20">
                <span>SIAPP ERP v10</span>
                <span class="flex items-center gap-1"><i class="fa-solid fa-shield-check"></i> 100% Confiable</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    );
  })}
</section>
