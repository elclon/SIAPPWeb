---
import Layout from '../layouts/Layout.astro';
import GaleriaSistema from '../components/landing/GaleriaSistema.vue';
---

<Layout title="SIAPP | Sistema Integral Académico y Plataforma Pedagógica">
  
  <!-- HERO SECTION CON FONDO ORGÁNICO SUAVE (INSPIRADO EN SIAPP.EDU.PE) -->
  <section class="relative overflow-hidden pt-10 pb-20 lg:pt-16 lg:pb-28 bg-white">
    
    <!-- GRADIENTES DE FONDO AURORA (Celeste a la izquierda, Cálido Durazno/Rosa a la derecha) -->
    <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-gradient-to-tr from-sky-200/50 via-blue-100/40 to-transparent rounded-full blur-3xl pointer-events-none -translate-x-1/3 -translate-y-1/4"></div>
    <div class="absolute top-10 right-0 w-[650px] h-[650px] bg-gradient-to-bl from-rose-200/45 via-orange-100/35 to-transparent rounded-full blur-3xl pointer-events-none translate-x-1/4"></div>
    
    <!-- LÍNEAS VECTORIALES ONDULADAS ORGÁNICAS (SVG CONTOUR WAVE LINES) -->
    <div class="absolute inset-0 pointer-events-none opacity-30 overflow-hidden">
      <svg class="w-full h-full" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M-100 200 C 300 120, 450 380, 800 220 C 1150 60, 1300 350, 1600 240" stroke="#3b82f6" stroke-width="1.2" stroke-dasharray="6 6" fill="none" />
        <path d="M-50 350 C 350 220, 500 480, 900 320 C 1200 200, 1350 480, 1650 360" stroke="#6366f1" stroke-width="1" fill="none" />
        <path d="M0 500 C 400 380, 600 620, 1000 450 C 1300 320, 1400 580, 1700 480" stroke="#f43f5e" stroke-width="1" opacity="0.6" fill="none" />
      </svg>
    </div>

    <!-- ELEMENTOS FLOTANTES 3D (ESFERAS, ANILLOS Y DIAMANTES DECORATIVOS) -->
    <div class="absolute inset-0 max-w-7xl mx-auto pointer-events-none overflow-hidden">
      <!-- Esfera Púrpura 3D Flotante (Izquierda) -->
      <div class="absolute top-44 left-6 sm:left-14 w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-purple-700 via-indigo-600 to-purple-400 shadow-xl shadow-purple-600/35 animate-float"></div>
      
      <!-- Diamante / Cuadrado Hueco Azul (Izquierda Superior) -->
      <div class="absolute top-28 left-20 sm:left-36 w-6 h-6 border-2 border-blue-500 rounded-sm rotate-45 opacity-70 animate-float-reverse"></div>
      
      <!-- Anillo Magenta 3D (Derecha Superior) -->
      <div class="absolute top-24 right-16 sm:right-36 w-8 h-8 rounded-full border-[3px] border-rose-500 opacity-70 animate-float"></div>
      
      <!-- Puntos Geométricos Sutiles -->
      <div class="absolute top-20 left-1/3 w-2.5 h-2.5 rounded-full bg-blue-600 opacity-80"></div>
      <div class="absolute top-48 right-1/4 w-3 h-3 rounded-full bg-emerald-500 opacity-80 animate-pulse"></div>
      <div class="absolute top-64 right-12 w-2 h-2 rounded-full bg-orange-500 opacity-80"></div>
    </div>

    <!-- CONTENIDO DEL HERO -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- CABECERA DE TEXTO DEL HERO -->
      <div class="text-center max-w-3xl mx-auto space-y-6">
        
        <!-- Título Principal Exacto de SIAPP -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.12] font-heading">
          Sistema Integral Académico <br class="hidden sm:inline" />
          <span class="text-blue-600 font-black">&</span> Plataforma Pedagógica
        </h1>

        <!-- Subtítulo Fiel a la Propuesta de Valor -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto">
          Novedoso software de gestión académica de nivel superior. Permite gestionar todo el proceso educativo desde la matrícula hasta la graduación y seguimiento de egresado de un alumno.
        </p>

        <!-- Botón CTA Rojo/Naranja en Píldora (Estilo Identitario) -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/contacto"
            class="px-9 py-4 rounded-full text-base font-bold bg-gradient-to-r from-red-500 via-rose-500 to-orange-500 hover:from-red-600 hover:to-orange-600 active:scale-[0.98] text-white shadow-xl shadow-orange-500/25 hover:shadow-orange-500/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2.5"
          >
            <span>Solicita una cita demostrativa</span>
            <i class="fa-light fa-calendar-check text-lg"></i>
          </a>

          <a
            href="/modulos"
            class="px-7 py-4 rounded-full text-base font-semibold border border-slate-300 bg-white/80 backdrop-blur-sm text-slate-700 hover:bg-white hover:border-slate-400 hover:text-slate-900 transition-all flex items-center justify-center gap-2"
          >
            <i class="fa-light fa-layer-group text-blue-600"></i>
            <span>Explorar Módulos</span>
          </a>
        </div>

      </div>

      <!-- SHOWCASE DE DISPOSITIVOS: LAPTOP CON CAPTURA DEL SISTEMA + MÓVIL FLOTANTE -->
      <div class="mt-14 sm:mt-18 relative max-w-5xl mx-auto">
        
        <!-- Blob Orgánico Azul de Fondo (Detrás del Laptop) -->
        <div class="absolute -top-12 -right-8 sm:-right-12 w-64 sm:w-80 h-64 sm:h-80 bg-blue-600 rounded-[40%_60%_70%_30%/40%_50%_60%_50%] opacity-90 blur-xs pointer-events-none -z-10 animate-float-slow"></div>
        <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-gradient-to-tr from-purple-600 to-indigo-600 rounded-full opacity-20 blur-3xl pointer-events-none -z-10"></div>

        <!-- MOCKUP DE LAPTOP PROFESIONAL -->
        <div class="relative mx-auto rounded-t-3xl bg-slate-950 p-3 sm:p-4 shadow-2xl shadow-slate-900/30 border border-slate-800">
          
          <!-- Cámara Web y Notch Superior -->
          <div class="flex items-center justify-center pb-2.5 relative">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center">
              <span class="w-1 h-1 rounded-full bg-blue-900"></span>
            </span>
          </div>

          <!-- Pantalla del Laptop -->
          <div class="relative rounded-xl overflow-hidden bg-slate-900 border border-slate-800 aspect-[16/10] flex items-center justify-center group">
            
            <!-- Imagen real si el usuario coloca: public/images/sistema/pantalla-principal.png -->
            <img
              src="/images/sistema/pantalla-principal.png"
              alt="SIAPP - Pantalla Principal del Sistema"
              class="w-full h-full object-cover object-top"
              onerror="this.style.display='none'"
            />

            <!-- Fallback Interactivo de Alta Fidelidad de la Interfaz SIAPP (Ribbon + Módulos) -->
            <div class="absolute inset-0 bg-slate-100 flex flex-col justify-between text-slate-800 select-none">
              
              <!-- Barra de Título Superior de Windows -->
              <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white px-4 py-2 flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                  <i class="fa-sharp fa-solid fa-graduation-cap text-blue-400"></i>
                  <span class="font-bold tracking-tight">Sistema Integral Académico &bull; SIAPP ERP v10.0</span>
                </div>
                <div class="flex items-center gap-3 text-[11px] text-slate-300 font-mono">
                  <span>Sucursal: Central Lima</span>
                  <span>Usuario: Administrador</span>
                </div>
              </div>

              <!-- Ribbon Navigation Bar de SIAPP -->
              <div class="bg-white border-b border-slate-200 px-4 py-2.5 shadow-xs">
                <!-- Pestañas del Ribbon -->
                <div class="flex items-center gap-1 sm:gap-2 pb-2 text-xs font-semibold border-b border-slate-100">
                  <span class="px-3 py-1 rounded bg-blue-600 text-white font-bold">Académico</span>
                  <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">Caja y Tesorería</span>
                  <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">Facturación SUNAT</span>
                  <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">Docentes</span>
                  <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">Reportes</span>
                  <span class="px-3 py-1 rounded text-slate-600 hover:bg-slate-100">Seguridad</span>
                </div>

                <!-- Botones de Acción del Ribbon -->
                <div class="flex items-center gap-4 pt-2 overflow-x-auto text-[11px] text-slate-700">
                  <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                    <i class="fa-light fa-id-card text-xl text-blue-600"></i>
                    <span>Ficha Alumno</span>
                  </div>
                  <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                    <i class="fa-light fa-user-plus text-xl text-indigo-600"></i>
                    <span>Matrícula</span>
                  </div>
                  <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                    <i class="fa-light fa-file-invoice text-xl text-emerald-600"></i>
                    <span>Cobranzas</span>
                  </div>
                  <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                    <i class="fa-light fa-fingerprint text-xl text-purple-600"></i>
                    <span>Asistencias</span>
                  </div>
                  <div class="flex flex-col items-center gap-1 hover:text-blue-600 cursor-pointer">
                    <i class="fa-light fa-chart-line-up text-xl text-amber-600"></i>
                    <span>Estadísticas</span>
                  </div>
                </div>
              </div>

              <!-- Área de Trabajo Central con Marca de Agua del Escudo -->
              <div class="my-auto p-6 flex flex-col items-center justify-center relative">
                <!-- Marca de Agua del Escudo y Birrete (Tal como en siapp.edu.pe) -->
                <div class="opacity-15 flex flex-col items-center text-slate-400">
                  <i class="fa-sharp fa-solid fa-graduation-cap text-8xl sm:text-9xl"></i>
                  <span class="font-['Outfit',sans-serif] font-black text-2xl tracking-widest mt-2 uppercase text-slate-400">SIAPP</span>
                </div>
                <div class="absolute bottom-4 left-4 text-xs text-slate-400 font-medium">
                  Instituto de Educación Superior Tecnológico &bull; Ciclo 2026-II
                </div>
              </div>

            </div>

          </div>

          <!-- Base del Laptop (Teclado / Bisagra) -->
          <div class="h-4 sm:h-5 bg-gradient-to-b from-slate-800 to-slate-900 rounded-b-xl -mb-2 shadow-md flex items-center justify-center">
            <span class="w-16 h-1 rounded-full bg-slate-700"></span>
          </div>

        </div>

        <!-- TARJETA FLOTANTE 1: FOTO DE ESTUDIANTES / DOCENTES (Tal como en siapp.edu.pe) -->
        <div class="absolute top-10 sm:top-14 right-2 sm:-right-8 w-28 sm:w-44 rounded-2xl overflow-hidden shadow-2xl border-4 border-white transform rotate-3 hover:rotate-0 transition-transform duration-300 hidden md:block">
          <img
            src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=400&q=80"
            alt="Estudiantes Universitarios"
            class="w-full h-24 sm:h-32 object-cover"
          />
          <div class="bg-white p-2 text-center">
            <span class="block text-[10px] font-bold text-slate-800">+50,000 Alumnos</span>
            <span class="block text-[8px] text-slate-400">Gestión Activa en Nube</span>
          </div>
        </div>

        <!-- TARJETA FLOTANTE 2: SMARTPHONE CON EL PORTAL MÓVIL DEL ALUMNO -->
        <div class="absolute -bottom-8 -right-4 sm:-right-10 w-44 sm:w-56 bg-slate-950 p-2.5 rounded-3xl shadow-2xl border-2 border-slate-800 transform -rotate-3 hover:rotate-0 transition-transform duration-300 hidden sm:block">
          <div class="rounded-2xl overflow-hidden bg-white p-3 space-y-2 border border-slate-200">
            <div class="flex items-center justify-between pb-1.5 border-b border-slate-100">
              <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-graduation-cap text-blue-600 text-sm"></i>
                <span class="font-black text-xs text-slate-900">siapp móvil</span>
              </div>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            </div>
            <div class="space-y-1.5 text-[10px]">
              <div class="p-1.5 bg-blue-50 rounded-lg text-blue-800 font-semibold">
                Bienvenido, Carlos Zegarra
              </div>
              <div class="flex justify-between text-slate-600 text-[9px] py-0.5">
                <span>Promedio Ponderado:</span>
                <span class="font-bold text-emerald-600">17.8</span>
              </div>
              <div class="flex justify-between text-slate-600 text-[9px] py-0.5">
                <span>Estado de Pago:</span>
                <span class="font-bold text-blue-600">Al Día</span>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>

  </section>

  <!-- SECCIÓN NUEVA: GALERÍA Y CAPTURAS REALES DEL SISTEMA ("VISTAS DEL SISTEMA") -->
  <section class="py-20 bg-slate-50 border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Plataforma en Acción</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-heading">
          Explora las Pantallas y Módulos de SIAPP
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Una interfaz pensada para la velocidad administrativa, fluida y con toda la información crítica a un solo clic.
        </p>
      </div>

      <!-- Componente Vue de Galería Interactiva con Pestañas y Visor -->
      <GaleriaSistema client:visible />

    </div>
  </section>

  <!-- SECCIÓN RESUMEN DE MÓDULOS -->
  <section class="py-20 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Arquitectura Modular</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-heading">
          Soluciones diseñadas para cada área de tu institución
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Módulos 100% integrados en tiempo real que eliminan el uso de hojas de cálculo y optimizan los procesos administrativos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Card 1: Académico -->
        <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/90 hover:border-blue-300 hover:shadow-xl hover:shadow-blue-500/5 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <i class="fa-light fa-graduation-cap"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 font-heading">Gestión Académica</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Planes curriculares, horarios por docente, malla de materias, control de ciclos y semestres con validaciones automáticas de prerrequisitos.
          </p>
          <a href="/modulos#academico" class="text-sm font-semibold text-blue-600 flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            <span>Conoce más</span> <i class="fa-light fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Card 2: Caja y Tesorería -->
        <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/90 hover:border-emerald-300 hover:shadow-xl hover:shadow-emerald-500/5 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl mb-5 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
            <i class="fa-light fa-cash-register"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 font-heading">Caja y Tesorería</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Planes de pago flexibles, control de deudas en tiempo real, arqueos de caja por sucursal, integración con bancos y recaudaciones.
          </p>
          <a href="/modulos#tesoreria" class="text-sm font-semibold text-emerald-600 flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            <span>Conoce más</span> <i class="fa-light fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Card 3: Facturación SUNAT -->
        <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/90 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-500/5 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl mb-5 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
            <i class="fa-light fa-receipt"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 font-heading">Facturación Electrónica</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Emisión directa a SUNAT de boletas y facturas electrónicas, notas de crédito, control de contingencias y retransmisión automática.
          </p>
          <a href="/modulos#facturacion" class="text-sm font-semibold text-indigo-600 flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            <span>Conoce más</span> <i class="fa-light fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Card 4: Biométrico -->
        <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/90 hover:border-purple-300 hover:shadow-xl hover:shadow-purple-500/5 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl mb-5 group-hover:bg-purple-600 group-hover:text-white transition-colors">
            <i class="fa-light fa-fingerprint"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 font-heading">Control Biométrico</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Registro de asistencia con lectores biométricos IP para alumnos y docentes. Cálculo de horas lectivas y reporte de inasistencias.
          </p>
          <a href="/modulos#biometrico" class="text-sm font-semibold text-purple-600 flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            <span>Conoce más</span> <i class="fa-light fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Card 5: Portales Alumno/Docente -->
        <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/90 hover:border-cyan-300 hover:shadow-xl hover:shadow-cyan-500/5 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-600 flex items-center justify-center text-xl mb-5 group-hover:bg-cyan-600 group-hover:text-white transition-colors">
            <i class="fa-light fa-laptop-mobile"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 font-heading">Portal Web y Móvil</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Los alumnos y docentes acceden desde cualquier dispositivo para consultar notas, asistencias, horarios y descargar constancias en PDF.
          </p>
          <a href="/modulos#portales" class="text-sm font-semibold text-cyan-600 flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            <span>Conoce más</span> <i class="fa-light fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Card 6: Reportes y BI -->
        <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/90 hover:border-amber-300 hover:shadow-xl hover:shadow-amber-500/5 transition-all group">
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl mb-5 group-hover:bg-amber-600 group-hover:text-white transition-colors">
            <i class="fa-light fa-chart-pie"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 font-heading">Reportes & Estadísticas</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Informes detallados para dirección: morosidad acumulada, retención estudiantil, rankings de notas y exportación a Excel en un clic.
          </p>
          <a href="/modulos#reportes" class="text-sm font-semibold text-amber-600 flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            <span>Conoce más</span> <i class="fa-light fa-arrow-right text-xs"></i>
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- BANNER CTA AL PORTAL DE CLIENTES (AUTOSERVICIO & COBRO) -->
  <section class="py-16 bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        
        <div class="space-y-3 max-w-2xl text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xs font-semibold">
            <i class="fa-light fa-wallet"></i>
            <span>Portal de Autoservicio para Instituciones Clientes</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight font-heading">
            ¿Ya eres cliente SIAPP? Renueva o liquida tu suscripción
          </h2>
          <p class="text-slate-300 text-sm sm:text-base">
            Ingresa tu código de cuenta (ej: 9999) o RUC para consultar tu estado de servicio y pagar tu mensualidad de forma inmediata con habilitación automática.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a
            href="/clientes?cuenta=9999"
            class="px-8 py-4 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-400 active:scale-[0.98] text-slate-950 shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center gap-2 text-center"
          >
            <i class="fa-light fa-credit-card"></i>
            <span>Ir al Portal de Pagos (Cuenta 9999)</span>
          </a>
          <a
            href="/contacto"
            class="px-6 py-4 rounded-xl text-sm font-semibold border border-slate-700 bg-slate-800/80 hover:bg-slate-800 text-white transition-all flex items-center justify-center gap-2 text-center"
          >
            <span>Soporte Técnico</span>
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>
