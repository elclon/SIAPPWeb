---
import Layout from '../../layouts/Layout.astro';
import AdminPortalCliente from '../../components/portal/AdminPortalCliente.vue';
// Theme oficial Fluent SaaS de SIAPPClient
import 'devextreme/dist/css/dx.fluent.saas.light.css';
---

<Layout
  title="Panel de Administración SaaS | SIAPP"
  description="Panel exclusivo para la gestión de clientes, auditoría multi-base de datos, emisión de cobranzas con detracciones y publicación de manuales."
>
  <div class="bg-gradient-to-b from-slate-100 via-white to-slate-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 min-h-screen py-8 sm:py-12 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb / Navegación Superior -->
      <div class="mb-6 flex items-center justify-between pt-4">
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-medium">
          <a
            href="/"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            Inicio
          </a>
          <i class="fa-light fa-chevron-right text-[10px]"></i>
          <a
            href="/clientes"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            Portal de Clientes
          </a>
          <i class="fa-light fa-chevron-right text-[10px]"></i>
          <span class="text-slate-800 dark:text-slate-200 font-bold">
            Administración SuperAdmin
          </span>
        </div>

        <a
          href="/clientes"
          class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1.5"
        >
          <i class="fa-light fa-eye"></i>
          <span>Ver Vista como Cliente</span>
        </a>
      </div>

      <!-- Componente Vue SuperAdmin (Cargado en cliente para DevExtreme) -->
      <AdminPortalCliente client:only="vue" />
    </div>
  </div>
</Layout>
