---
import Layout from '../layouts/Layout.astro';
import NosotrosHeader from '../components/nosotros/NosotrosHeader.astro';
import NosotrosMisionVision from '../components/nosotros/NosotrosMisionVision.astro';
import NosotrosPilares from '../components/nosotros/NosotrosPilares.astro';
---

<Layout 
  title="Sobre Nosotros | SIAPP Software Académico"
  description="Conoce la visión, trayectoria y el equipo detrás de SIAPP, la plataforma tecnológica educativa del Perú."
>
  <NosotrosHeader />

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <NosotrosMisionVision />
    <NosotrosPilares />
  </section>
</Layout>
