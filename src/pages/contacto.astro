---
import Layout from '../layouts/Layout.astro';
import ContactoHeader from '../components/contacto/ContactoHeader.astro';
import ContactoInfo from '../components/contacto/ContactoInfo.astro';
import ContactoForm from '../components/contacto/ContactoForm.astro';
---

<Layout 
  title="Contacto y Demostración | SIAPP Software Académico"
  description="Ponte en contacto con nuestro equipo para agendar una demostración en vivo o solicitar una propuesta comercial."
>
  <ContactoHeader />

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Columna Izquierda: Información Directa -->
      <div class="lg:col-span-5">
        <ContactoInfo />
      </div>

      <!-- Columna Derecha: Formulario de Contacto -->
      <div class="lg:col-span-7">
        <ContactoForm />
      </div>
    </div>
  </section>
</Layout>
