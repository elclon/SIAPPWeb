---
import Layout from '../../layouts/Layout.astro';
import PortalCliente from '../../components/portal/PortalCliente.vue';
import 'devextreme/dist/css/dx.fluent.saas.light.css';
---

<Layout 
  title="Portal de Clientes y Pagos | SIAPP Gestión Académica"
  description="Acceso exclusivo para instituciones clientes de SIAPP. Consulta tu estado de suscripción, liquida tu mensualidad en línea y habilita tu servicio de manera automática."
>
  <div class="bg-gradient-to-b from-slate-100 via-white to-slate-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 min-h-screen py-10 sm:py-14 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb / Header de Navegación -->
      <div class="mb-6 flex items-center justify-between">
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-medium">
          <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Inicio</a>
          <i class="fa-light fa-chevron-right text-[10px]"></i>
          <span class="text-slate-800 dark:text-slate-200 font-bold">Portal de Clientes</span>
        </div>

        <a
          href="/contacto"
          class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1.5"
        >
          <i class="fa-light fa-comment-question"></i>
          <span>¿Dudas con tu facturación? Contáctanos</span>
        </a>
      </div>

      <!-- Componente Interactivo Vue del Portal de Clientes -->
      <PortalCliente client:only="vue" />

    </div>
  </div>
</Layout>
