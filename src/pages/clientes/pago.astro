---
import Layout from '../../layouts/Layout.astro';
import PortalCliente from '../../components/portal/PortalCliente.vue';
---

<Layout 
  title="Pagar Suscripción SIAPP | Pasarela Segura de Pagos"
  description="Paga tu recibo de suscripción mensual SIAPP en línea mediante tarjeta de crédito, débito, Yape o transferencia bancaria y reactiva tu sistema inmediatamente."
>
  <div class="bg-gradient-to-b from-slate-100 via-white to-slate-50 min-h-screen py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb / Header de Navegación -->
      <div class="mb-6 flex items-center justify-between">
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium">
          <a href="/" class="hover:text-blue-600 transition-colors">Inicio</a>
          <i class="fa-light fa-chevron-right text-[10px]"></i>
          <a href="/clientes" class="hover:text-blue-600 transition-colors">Portal de Clientes</a>
          <i class="fa-light fa-chevron-right text-[10px]"></i>
          <span class="text-slate-800 font-bold">Pasarela de Pagos</span>
        </div>

        <div class="flex items-center gap-2 text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full font-semibold">
          <i class="fa-solid fa-lock"></i>
          <span>Pasarela Protegida SSL</span>
        </div>
      </div>

      <!-- Componente Interactivo Vue del Portal de Clientes -->
      <PortalCliente client:load />

    </div>
  </div>
</Layout>
