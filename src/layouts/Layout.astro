---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}

const { 
  title = "SIAPP | Sistema Integral de Gestión Académica", 
  description = "Software ERP y gestión académica integral para institutos, colegios y universidades del Perú.",
  hideFooter = false
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Inter / Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Font Awesome Pro Oficial Local -->
    <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/solid.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/light.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/brands.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/duotone.min.css" />

    <!-- Anti-FOUC Dark Mode Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-['Inter',sans-serif] min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white transition-colors duration-200">
    <!-- Navbar Global -->
    <Navbar />

    <!-- Contenido de la Página -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Global -->
    {!hideFooter && <Footer />}

    <!-- Botón Flotante de WhatsApp Global -->
    <FloatingWhatsApp />
  </body>
</html>

<style is:global>
  h1, h2, h3, h4, .font-heading {
    font-family: 'Outfit', sans-serif;
  }
</style>

<script>
  import '../components/portal/admin/devextreme-init';
  import { obtenerConfiguracionWhatsApp } from '../services/configuracionService';

  async function sincronizarEnlacesWhatsApp() {
    try {
      const config = await obtenerConfiguracionWhatsApp();
      if (!config) return;

      // 1. Actualizar enlaces directos a WhatsApp (wa.me)
      document.querySelectorAll('[data-whatsapp-link]').forEach(el => {
        const tipo = el.getAttribute('data-whatsapp-link');
        let targetUrl = config.urlWhatsAppGeneral;
        if (tipo === 'soporte') {
          targetUrl = config.urlWhatsAppSoporte;
        } else if (tipo === 'ventas') {
          targetUrl = config.urlWhatsAppVentas;
        }

        if (targetUrl) {
          el.setAttribute('href', targetUrl);
        }
      });

      // 2. Actualizar textos de número telefónico
      document.querySelectorAll('[data-whatsapp-text]').forEach(el => {
        const tipo = el.getAttribute('data-whatsapp-text');
        if (tipo === 'numeroFormateado' && config.numeroFormateado) {
          el.textContent = config.numeroFormateado;
        } else if (tipo === 'numero' && config.numero) {
          el.textContent = config.numero;
        }
      });

      // 3. Actualizar enlaces tel:
      document.querySelectorAll('[data-tel-link]').forEach(el => {
        if (config.numero) {
          el.setAttribute('href', `tel:+${config.numero}`);
        }
      });
    } catch (e) {
      console.error('Error al sincronizar configuración de WhatsApp en cliente:', e);
    }
  }

  if (typeof document !== 'undefined') {
    sincronizarEnlacesWhatsApp();
    document.addEventListener('astro:page-load', sincronizarEnlacesWhatsApp);
  }
</script>
